<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Forseti" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/forseti_background</item>
        <item name="android:navigationBarColor">@color/forseti_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Forseti.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/forseti_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_raven_scales</item>
        <item name="windowSplashScreenAnimationDuration">1500</item>
        <item name="postSplashScreenTheme">@style/Theme.Forseti</item>
    </style>
</resources>
