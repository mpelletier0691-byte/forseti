# Copy this file to `keystore.properties` (same directory) and fill in the
# real values. `keystore.properties` is gitignored on purpose — never commit
# the real one.
#
# Used by app/build.gradle.kts to sign release builds for Google Play upload.
# An equivalent set of env vars (FORSETI_KEYSTORE_FILE, FORSETI_KEYSTORE_PASSWORD,
# FORSETI_KEY_ALIAS, FORSETI_KEY_PASSWORD) is read as a fallback so CI can
# inject the values without writing a file.

storeFile=/home/your-username/forseti-upload.jks
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyAlias=forseti-upload
keyPassword=REPLACE_WITH_KEY_PASSWORD
